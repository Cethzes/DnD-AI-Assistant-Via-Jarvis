# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get a key at https://dashboard.voyageai.com/ (Anthropic's recommended embeddings partner)
# Voyage offers a free tier that's plenty for local development/demo purposes.
VOYAGE_API_KEY=your_voyage_api_key_here

# Model used for generation. See https://docs.claude.com/en/docs/about-claude/models/overview
CLAUDE_MODEL=claude-sonnet-5

PORT=3001

# This project runs fully locally via Ollama - no API keys required.
#
# 1. Install Ollama: https://ollama.com/download
# 2. Pull a chat model, e.g.:      ollama pull llama3.1
# 3. Pull an embedding model:      ollama pull nomic-embed-text
# 4. Make sure Ollama is running (it runs as a background service after
#    install, or start it manually with `ollama serve`).

# Base URL where Ollama is listening (default is correct for a local install)
OLLAMA_URL=http://localhost:11434

# Chat/generation model - must match a model you've pulled with `ollama pull`
OLLAMA_MODEL=llama3.1

# Embedding model - must match a model you've pulled with `ollama pull`
OLLAMA_EMBED_MODEL=nomic-embed-text

PORT=3001
